PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=home_holiday_hunt
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000
REDIS_URL=redis://127.0.0.1:6379

GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# --- Notifications ---
# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email — pick one provider
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=notifications@homeholidayhunt.example.com
SENDGRID_API_KEY=

# Only used if EMAIL_PROVIDER=ses (also needs AWS credentials available to
# the process — env vars, shared config file, or an IAM role)
AWS_REGION=

# Where admin-facing alerts (e.g. yard sign replacement requests) go
ADMIN_NOTIFY_EMAIL=